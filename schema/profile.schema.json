{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goettschepreppy/profile.schema.json",
  "title": "GoettschePreppy household profile",
  "description": "Everything the settings page collects. Produced in the browser, sent once to the relay, never stored server-side. See docs/02-profile-schema.md for the questions and the reasons.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "home",
    "dwelling",
    "members",
    "experience",
    "decision_cards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "access": {
      "type": "object",
      "description": "Optional in a saved profile.json, which never contains the access key. The object passed to generateBinder() must have access.access_key and access.acknowledged_notice; the settings page enforces that with a stricter variant of this schema built by scripts/build-settings.mjs (validateGenerate).",
      "additionalProperties": false,
      "required": [
        "acknowledged_notice"
      ],
      "properties": {
        "access_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "acknowledged_notice": {
          "const": true
        },
        "save_profile_locally": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "county",
        "setting"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "county": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "nearest_town": {
          "type": "string",
          "maxLength": 64
        },
        "setting": {
          "enum": [
            "urban",
            "suburban",
            "small-town",
            "rural",
            "remote"
          ]
        },
        "elevation_band": {
          "enum": [
            "low",
            "mid",
            "high"
          ]
        }
      }
    },
    "dwelling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dwelling_type",
        "water_supply",
        "sewer",
        "primary_heat"
      ],
      "properties": {
        "dwelling_type": {
          "enum": [
            "detached-house",
            "townhouse-duplex",
            "apartment",
            "mobile-manufactured",
            "farm-ranch",
            "other"
          ]
        },
        "stories": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "basement": {
          "enum": [
            "none",
            "full",
            "walkout",
            "crawlspace"
          ]
        },
        "windowless_interior_room": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "which": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        "water_supply": {
          "enum": [
            "municipal",
            "private-well",
            "shared-well",
            "cistern-haul",
            "other"
          ]
        },
        "sewer": {
          "enum": [
            "municipal",
            "septic",
            "other"
          ]
        },
        "primary_heat": {
          "enum": [
            "natural-gas-furnace",
            "propane-furnace",
            "heating-oil",
            "electric-resistance",
            "heat-pump",
            "wood-stove",
            "pellet-stove",
            "other"
          ]
        },
        "gas_service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "none",
                "natural-gas",
                "propane-tank"
              ]
            },
            "tank_gallons": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cooking_fuel": {
          "enum": [
            "electric",
            "natural-gas",
            "propane",
            "other"
          ]
        },
        "water_heater": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "none",
                "tank-gas",
                "tank-electric",
                "tankless"
              ]
            },
            "gallons": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            }
          }
        },
        "fire_features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "indoor-fireplace",
              "wood-stove",
              "outdoor-fireplace",
              "fire-pit"
            ]
          }
        },
        "pool_or_hot_tub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "none",
                "chlorine-pool",
                "saltwater-pool",
                "hot-tub"
              ]
            },
            "gallons": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "garden_space": {
          "enum": [
            "none",
            "containers",
            "small-yard",
            "large-yard",
            "acreage"
          ]
        },
        "attached_garage": {
          "type": "boolean"
        },
        "vehicles": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "fuel"
            ],
            "properties": {
              "type": {
                "enum": [
                  "car",
                  "suv",
                  "pickup",
                  "van",
                  "motorcycle",
                  "other"
                ]
              },
              "fuel": {
                "enum": [
                  "gasoline",
                  "diesel",
                  "hybrid",
                  "ev"
                ]
              },
              "four_wheel_drive": {
                "type": "boolean"
              },
              "can_tow": {
                "type": "boolean"
              }
            }
          }
        },
        "trailer": {
          "enum": [
            "none",
            "open-utility",
            "enclosed-cargo",
            "camper"
          ]
        },
        "roof_area_sqft": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000,
          "description": "Approximate roof footprint in square feet, for rain-catchment math."
        },
        "warm_room": {
          "type": "string",
          "maxLength": 80,
          "description": "Which room you would heat if you could heat only one."
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "role",
          "age"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "role": {
            "enum": [
              "adult",
              "teen",
              "child",
              "infant-toddler",
              "elder"
            ]
          },
          "age": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 120
              },
              "unit": {
                "enum": [
                  "years",
                  "months"
                ]
              }
            }
          },
          "weight": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 1,
                "maximum": 700
              },
              "unit": {
                "enum": [
                  "lb",
                  "kg"
                ]
              }
            }
          },
          "sex": {
            "enum": [
              "female",
              "male",
              "not-said"
            ]
          },
          "pregnant_or_nursing": {
            "enum": [
              "no",
              "pregnant",
              "nursing",
              "both"
            ]
          },
          "conditions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/conditionId"
            }
          },
          "conditions_other": {
            "type": "string",
            "maxLength": 200
          },
          "medications": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 80
                },
                "strength": {
                  "type": "string",
                  "maxLength": 40
                },
                "schedule": {
                  "type": "string",
                  "maxLength": 80
                },
                "refrigerated": {
                  "type": "boolean"
                },
                "if_missed": {
                  "type": "string",
                  "maxLength": 300,
                  "description": "The household's own words, from their prescriber or label. Printed as written; never interpreted."
                },
                "days_on_hand": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3650,
                  "description": "How many days of this medication the household has on hand, by its own count."
                },
                "where_kept": {
                  "type": "string",
                  "maxLength": 80
                },
                "expiry": {
                  "type": "string",
                  "maxLength": 20,
                  "description": "Expiry as printed on the package."
                },
                "for_condition": {
                  "type": "string",
                  "pattern": "^(CL-[0-9]{2}|other)$",
                  "description": "Which condition this medicine is for, if known."
                }
              }
            }
          },
          "allergies": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allergen",
                "severity"
              ],
              "properties": {
                "allergen": {
                  "type": "string",
                  "maxLength": 60
                },
                "severity": {
                  "enum": [
                    "mild",
                    "severe",
                    "anaphylaxis"
                  ]
                },
                "carries_epinephrine": {
                  "type": "boolean"
                }
              }
            }
          },
          "mobility_or_sensory": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "wheelchair-walker",
                "oxygen",
                "hearing-aids",
                "glasses-contacts",
                "cpap",
                "none"
              ]
            }
          },
          "skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "medical-professional",
                "nurse-emt",
                "electrician",
                "mechanic",
                "hunter",
                "ham-licence",
                "farmer-gardener",
                "firearms-trained",
                "none"
              ]
            }
          },
          "ham_callsign": {
            "type": "string",
            "pattern": "^[A-Za-z]{1,2}[0-9][A-Za-z]{1,3}$"
          },
          "due_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Pregnancy due date, if pregnant."
          }
        }
      }
    },
    "pets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "count"
        ],
        "properties": {
          "type": {
            "enum": [
              "dog",
              "cat",
              "other"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "medications": {
            "type": "string",
            "maxLength": 200
          },
          "food_per_day": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "livestock": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "count"
        ],
        "properties": {
          "type": {
            "enum": [
              "chickens",
              "ducks",
              "rabbits",
              "goats",
              "sheep",
              "pigs",
              "cattle",
              "horses",
              "bees",
              "other"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "state",
          "county",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "county": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "enum": [
              "agreed",
              "unannounced",
              "property-only",
              "undecided"
            ]
          },
          "who_is_there": {
            "type": "string",
            "maxLength": 300
          },
          "how_to_reach_them": {
            "type": "string",
            "maxLength": 300
          },
          "route_notes": {
            "type": "string",
            "maxLength": 1000
          },
          "approximate_miles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4000
          },
          "water_source": {
            "enum": [
              "municipal",
              "well",
              "spring-or-surface",
              "cistern",
              "unknown"
            ]
          },
          "sewer": {
            "enum": [
              "municipal",
              "septic",
              "outhouse",
              "none-or-unknown"
            ]
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "out_of_area_contact": {
          "$ref": "#/$defs/contact"
        },
        "meeting_place_near_home": {
          "type": "string",
          "maxLength": 200
        },
        "meeting_place_in_town": {
          "type": "string",
          "maxLength": 200
        },
        "meeting_place_out_of_town": {
          "type": "string",
          "maxLength": 200
        },
        "utilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "electric": {
              "$ref": "#/$defs/utility"
            },
            "gas": {
              "$ref": "#/$defs/utility"
            },
            "water": {
              "$ref": "#/$defs/utility"
            }
          }
        },
        "local_contacts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/contact"
          }
        }
      }
    },
    "gear": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "power_stations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "maxLength": 60
              },
              "wh": {
                "type": "number",
                "minimum": 0
              },
              "pv_input_max_v": {
                "type": "number",
                "minimum": 0
              },
              "pv_input_max_w": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "solar_panels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "maxLength": 60
              },
              "watts": {
                "type": "number",
                "minimum": 0
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "voc": {
                "type": "number",
                "minimum": 0,
                "description": "Open-circuit voltage from the panel label."
              },
              "isc": {
                "type": "number",
                "minimum": 0,
                "description": "Short-circuit current from the panel label."
              }
            }
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fuel": {
              "enum": [
                "gasoline",
                "propane",
                "dual-fuel",
                "tri-fuel",
                "diesel"
              ]
            },
            "inverter": {
              "type": "boolean"
            },
            "watts": {
              "type": "number",
              "minimum": 0
            },
            "model": {
              "type": "string",
              "maxLength": 60
            },
            "volts": {
              "enum": [
                "120",
                "120-240"
              ]
            }
          }
        },
        "house_connection": {
          "enum": [
            "none",
            "interlock",
            "cord-and-plug",
            "transfer-switch"
          ]
        },
        "car_inverter": {
          "type": "boolean"
        },
        "heaters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "portable-propane",
                  "wick-kerosene",
                  "ducted-diesel-kerosene",
                  "wood-stove",
                  "pellet-stove",
                  "electric-only"
                ]
              },
              "model": {
                "type": "string",
                "maxLength": 60
              },
              "btu": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200000
              }
            }
          }
        },
        "fuel_on_hand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gasoline_gal": {
              "type": "number",
              "minimum": 0
            },
            "diesel_gal": {
              "type": "number",
              "minimum": 0
            },
            "kerosene_gal": {
              "type": "number",
              "minimum": 0
            },
            "propane_1lb": {
              "type": "integer",
              "minimum": 0
            },
            "propane_20lb": {
              "type": "integer",
              "minimum": 0
            },
            "propane_bulk_gal": {
              "type": "number",
              "minimum": 0
            },
            "firewood_cords": {
              "type": "number",
              "minimum": 0
            },
            "charcoal_lb": {
              "type": "number",
              "minimum": 0
            },
            "lamp_oil_gal": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "water": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stored_gal": {
              "type": "number",
              "minimum": 0
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 60
              }
            },
            "bleach_or_shock": {
              "type": "boolean"
            },
            "barrels": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cooking": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "camp-stove-propane",
              "camp-stove-liquid",
              "rocket-stove",
              "dutch-oven",
              "solar-oven",
              "electric-kettle"
            ]
          }
        },
        "comms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "noaa_radio": {
              "type": "boolean"
            },
            "frs_gmrs": {
              "type": "boolean"
            },
            "gmrs_licence": {
              "type": "boolean"
            },
            "ham": {
              "type": "boolean"
            },
            "cb": {
              "type": "boolean"
            },
            "satellite_messenger": {
              "type": "boolean"
            },
            "starlink": {
              "type": "boolean"
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "first_aid_tier": {
              "enum": [
                "none",
                "basic",
                "trauma",
                "long-haul"
              ]
            },
            "co_alarms": {
              "type": "integer",
              "minimum": 0
            },
            "smoke_alarms": {
              "type": "integer",
              "minimum": 0
            },
            "extinguishers": {
              "type": "integer",
              "minimum": 0
            },
            "fire_blankets": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "firearms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owned": {
              "type": "boolean"
            },
            "platforms_and_calibers": {
              "type": "string",
              "maxLength": 300
            },
            "safe": {
              "type": "boolean"
            },
            "suppressors": {
              "type": "boolean"
            }
          }
        },
        "food": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pantry_days": {
              "type": "integer",
              "minimum": 0
            },
            "bulk_staples_lb": {
              "type": "number",
              "minimum": 0
            },
            "freeze_dried_servings": {
              "type": "integer",
              "minimum": 0
            },
            "canning": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "water-bath",
                  "pressure-dial",
                  "pressure-weighted"
                ]
              }
            },
            "dehydrator": {
              "type": "boolean"
            },
            "seeds": {
              "type": "boolean"
            }
          }
        },
        "transport": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "bicycles",
              "hand-cart",
              "snowshoes-skis"
            ]
          }
        }
      }
    },
    "experience": {
      "enum": [
        "new",
        "some",
        "experienced"
      ]
    },
    "decision_cards": {
      "type": "object",
      "description": "One entry per card id DC-01..DC-31; value is the chosen option id or 'undecided'.",
      "propertyNames": {
        "pattern": "^DC-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9-]{1,32}|undecided)$"
      }
    },
    "notes_for_the_binder": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "DC",
        "FL",
        "GA",
        "HI",
        "ID",
        "IL",
        "IN",
        "IA",
        "KS",
        "KY",
        "LA",
        "ME",
        "MD",
        "MA",
        "MI",
        "MN",
        "MS",
        "MO",
        "MT",
        "NE",
        "NV",
        "NH",
        "NJ",
        "NM",
        "NY",
        "NC",
        "ND",
        "OH",
        "OK",
        "OR",
        "PA",
        "RI",
        "SC",
        "SD",
        "TN",
        "TX",
        "UT",
        "VT",
        "VA",
