{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "goettschepreppy/page.schema.json",
  "title": "GoettschePreppy page frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "section",
    "title",
    "version",
    "revised",
    "layer",
    "danger_level",
    "sources",
    "derived_from"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "section": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "revised": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "layer": {
      "enum": [
        "core",
        "region",
        "household",
        "condition",
        "gear",
        "explainer",
        "card",
        "floors",
        "generated"
      ]
    },
    "danger_level": {
      "enum": [
        "none",
        "caution",
        "critical"
      ]
    },
    "phase": {
      "type": "array",
      "items": {
        "enum": [
          "A",
          "B",
          "C"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DC-[0-9]{2}$"
      }
    },
    "explainers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EX-[0-9]{2}$"
      }
    },
    "promote_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photo_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "caption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^fig-[a-z0-9-]+$"
      }
    },
    "plates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "condition": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CL-[0-9]{2}$"
    },
    "gear": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^GM-[0-9]{2}$"
    },
    "explainer": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EX-[0-9]{2}$"
    },
    "card": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DC-[0-9]{2}$"
    },
    "review_pass": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string"
        },
        "passes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "options": {
      "type": "array",
      "description": "Card pages only: the choices offered in settings and printed on the card.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "settings_summary": {
      "type": "string",
      "maxLength": 900,
      "description": "Card pages only: the plain-words hazard summary the settings page shows above the options (first five card parts, condensed)."
    }
  }
}